<script>
const rm = document.getElementById("recordModal")
let es = null;
let esMv = null;

function hideRecordModal() {
    rm.classList.remove("show");
    rm.style.display = "none";
}

async function waitForSseReady(maxWaitMs = 4000, pollMs = 150) {
    const started = Date.now();
    while ((Date.now() - started) < maxWaitMs) {
        try {
            const rsp = await fetch('/sse-ready', { cache: 'no-store' });
            if (rsp.ok) {
                const state = await rsp.json();
                if (state && state.active) {
                    return true;
                }
            }
        } catch (err) {
            // Retry until timeout.
        }
        await new Promise(resolve => setTimeout(resolve, pollMs));
    }
    return false;
}

async function startRipping(input) {
    console.log("startRipping..")

    if (input === "CD") {
        const discSelector = document.getElementById("discSelector");
        const requiresDiscSelection = !!(
            discSelector &&
            discSelector.options &&
            discSelector.options.length > 1 &&
            discSelector.value === "all"
        );
        if (requiresDiscSelection) {
            alert("Please select tracklist for one disc");
            return;
        }
    }

    rm.classList.add("show");
    rm.style.display = "flex";
    // First tell the server to start CD capture, then open SSE for progress.
    let response;
    if (input === "CD")
        response = await fetch("/cddvd", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(buildCapturePayload())
        });
    else
    {
        const auxPayload = buildCapturePayload();
        delete auxPayload.capture;
        auxPayload.action = "captureAux";
        response = await fetch("/cddvd", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(auxPayload)
        });
    }
    if (!response.ok) {
        console.log("Error !response.ok")
        let payload = null;
        try {
            payload = await response.json();
        } catch (err) { }
        hideRecordModal();
        if (payload && payload.message) {
            alert(payload.message);
        }
        return;
    }
    
    const sseReady = await waitForSseReady();
    if (!sseReady) {
        console.log("SSE readiness timeout, continue with direct EventSource connect");
    }

    console.log("start EventSource funcSSE")
    let gotFirstMessage = false;
    let retried = false;

    const connectSse = function() {
        es = new EventSource("/funcSSE");
        es.addEventListener("message", function(event) {
            gotFirstMessage = true;
            console.log("event.data="+event.data);
            const rV = document.getElementById("recordValue")
            if (rV)
                rV.innerText = event.data;
        });
        es.addEventListener("result", function(event) {
            es.close();
            hideRecordModal();
            const msg = event && event.data ? String(event.data) : "";
            if (msg.match(/done|sseEndDisc/i)) {
                try { localStorage.setItem('showADrecords.typeFilter', 'CD'); } catch(e) {}
                window.location.href = "/showADrecords?t=" + Date.now();
            }
        });
    };

    connectSse();
    setTimeout(function() {
        if (!gotFirstMessage && !retried) {
            retried = true;
            try { es.close(); } catch (e) {}
            console.log("No SSE message yet, reconnect EventSource once");
            connectSse();
        }
    }, 2500);

    console.log("CD capture started");
}

function stopRecording(){
    closeRecordModal()
}

async function startMoveAudio() {
    rm.classList.add("show");
    rm.style.display = "flex";
    await fetch("/cddvd", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ move: "disc" })
    });
    const sseReady = await waitForSseReady();
    if (!sseReady) {
        console.log("SSE readiness timeout, continue with direct EventSource connect");
    }

    let gotFirstMoveMessage = false;
    let moveRetried = false;

    const connectMoveSse = function() {
        esMv = new EventSource("/funcSSE");
        esMv.addEventListener("message", function(event) {
            gotFirstMoveMessage = true;
            const rV = document.getElementById("recordValue");
            if (rV) rV.innerText = event.data;
        });
        esMv.addEventListener("result", function(event) {
            esMv.close();
            hideRecordModal();
            const msg = event && event.data ? String(event.data) : "";
            if (msg.match(/done|sseEndDisc/i)) {
                try { localStorage.setItem('showADrecords.typeFilter', 'CD'); } catch(e) {}
                window.location.href = "/showADrecords?t=" + Date.now();
            }
        });
    };

    connectMoveSse();
    setTimeout(function() {
        if (!gotFirstMoveMessage && !moveRetried) {
            moveRetried = true;
            try { esMv.close(); } catch (e) {}
            console.log("No SSE message yet (move), reconnect EventSource once");
            connectMoveSse();
        }
    }, 2500);
}

async function closeRecordModal() {
    //Archtecture: client Start Rec --> Server starts "arecord" sends SSE modal info
    // --> client open recordModal shows bytes...--> recording, shows analyzer stuff in recordModal
    // --> server kills "adrecord" start analyzing -->sends SSE modal info --> refresh client page
    // --> client close recordModal
    rm.style.display = "none";
    if (es) es.close();
    try {
        await fetch('/audioCapture', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ recordingStop: "audioCapture" })
        });
        location.reload() //loads ejs var 
        // const data = await res.json();
    } catch (err) {
        console.error("audio analyzer probably failed:", err);
        // document.getElementById("recordModal").style.display = "none";
        // if (es) es.close();
    }
}
