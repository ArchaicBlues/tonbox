<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/captureModals'); %>
    <%- include('../partials/head'); %>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        <link rel="stylesheet" href="button.css">
        <link rel="manifest" href="/manifest/manifest.json?v=2">

        <style>
            /* CD/DVD Page Specific Styles */
            .track-list {
                list-style: none;
                padding: 0;
                margin: 0;
                width: 100%;
            }

            .track-item {
                padding: 1rem;
                margin-bottom: 0.5rem;
                background: rgba(255, 255, 255, 0.03);
                border-radius: 8px;
                cursor: pointer;
                transition: all 0.2s;
                border: 1px solid transparent;
                display: flex;
                align-items: center;
            }

            .track-item:hover {
                background: rgba(255, 255, 255, 0.1);
                transform: translateX(5px);
            }

            .track-item.active {
                background: rgba(0, 210, 255, 0.15);
                border-color: var(--accent-color);
                color: var(--accent-color);
                font-weight: 600;
            }

            .track-item::before {
                content: "\f001";
                /* Music Note */
                font-family: "Font Awesome 5 Free";
                font-weight: 900;
                margin-right: 15px;
                opacity: 0.5;
            }

            .control-panel {
                display: flex;
                justify-content: center;
                gap: 1rem;
                margin: 2rem 0;
            }

            .search-row {
                display: flex;
                width: 100%;
            }

            .search-btn {
                width: 100%;
                padding-inline: 1.2rem;
                min-height: calc(1.5em + 0.75rem + 2px);
                white-space: nowrap;
                flex: 1 1 auto;
            }

            /* Styles for generated images */
            .myClass {
                border-radius: 8px;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
                transition: transform 0.3s ease;
                max-width: 100%;
            }

            .myClass:hover {
                transform: scale(1.05);
                z-index: 10;
            }

            #image-container {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 1rem;
                padding: 1rem;
            }

            .close-btn,
            .insert-btn {
                background: var(--glass-bg);
                border: 1px solid var(--glass-border);
                color: white;
                padding: 5px 10px;
                border-radius: 4px;
                cursor: pointer;
            }

            .aux-capture-wrap {
                position: relative;
                width: 100%;
            }

            .track-editor-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
                gap: 0.5rem;
                max-height: 50vh;
                overflow-y: auto;
                margin-top: 0.75rem;
            }

            .track-editor-grid input {
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: #fff;
                border-radius: 6px;
                padding: 0.4rem 0.55rem;
                width: 100%;
            }

            .nothing-found-btn {
                border: 1px dashed rgba(255, 77, 77, 0.8);
                background: rgba(255, 77, 77, 0.18);
                color: #ffd7d7;
                border-radius: 6px;
                padding: 0.15rem 0.5rem;
                cursor: pointer;
                font-size: 0.9rem;
            }

            .aux-capture-hint {
                position: absolute;
                left: 50%;
                bottom: calc(100% + 0.75rem);
                transform: translateX(-50%);
                width: min(36rem, calc(100vw - 2rem));
                padding: 0.75rem 1rem;
                border-radius: 12px;
                background: #ffffff;
                border: 1px solid rgba(0, 0, 0, 0.18);
                color: #000000;
                font-size: 0.9rem;
                line-height: 1.35;
                text-align: center;
                box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
                opacity: 0;
                visibility: hidden;
                transition: opacity 0.15s ease, visibility 0.15s ease, transform 0.15s ease;
                z-index: 5;
                pointer-events: none;
            }

            .aux-capture-wrap:hover .aux-capture-hint,
            .aux-capture-wrap:focus-within .aux-capture-hint {
                opacity: 1;
                visibility: visible;
                transform: translateX(-50%) translateY(-2px);
            }
        </style>
</head>

