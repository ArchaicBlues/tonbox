            <script>
                /* --------- LOGIC ---------- */
                let lastTrack = null;
                const HISTORY_LIMIT = 20;
                const ARTIST_HISTORY_KEY = 'cdArtistHistory';
                const TITLE_HISTORY_KEY = 'cdTitleHistory';

                function loadHistory(key) {
                    try {
                        const parsed = JSON.parse(localStorage.getItem(key));
                        return Array.isArray(parsed) ? parsed : [];
                    } catch (e) {
                        return [];
                    }
                }

                function saveHistory(key, values) {
                    localStorage.setItem(key, JSON.stringify(values.slice(0, HISTORY_LIMIT)));
                }

                function addToHistory(key, value) {
                    if (!value) return;
                    const trimmed = value.trim();
                    if (!trimmed) return;
                    const current = loadHistory(key).filter(v => v !== trimmed);
                    current.unshift(trimmed);
                    saveHistory(key, current);
                }

                function renderHistoryList(listId, key) {
                    const list = document.getElementById(listId);
                    if (!list) return;
                    const values = loadHistory(key);
                    list.innerHTML = values.map(v => `<option value="${String(v).replace(/"/g, '&quot;')}"></option>`).join('');
                }

                function refreshInputHistory() {
                    renderHistoryList('artistHistoryList', ARTIST_HISTORY_KEY);
                    renderHistoryList('titleHistoryList', TITLE_HISTORY_KEY);
                }

                function triggerTracklistSearch() {
                    document.dispatchEvent(new CustomEvent('cd:tracklist'));
                }

                function parseMyDiscTrackCount(value) {
                    const match = String(value || '').trim().match(/^mydisc\s+(\d{1,2})$/i);
                    if (!match) return null;
                    const count = Number(match[1]);
                    return Number.isInteger(count) && count > 0 && count <= 50 ? count : null;
                }

                refreshInputHistory();
                window.manualTracklistSubmitted = false;
                window.manualDiscTitle = "";

                function applyImagesToPreview(currentImages) {
                    const images = Array.isArray(currentImages) ? currentImages : [];
                    for (let i = 1; i <= 21; i++) {
                        const img = document.getElementById(`img${i}`);
                        if (!img) continue;
                        if (i <= images.length) {
                            img.src = `${images[i - 1]}?t=${Date.now()}`;
                            img.style.display = "block";
                        } else {
                            img.style.display = "none";
                        }
                    }
                }

                const searchDiscButton = document.getElementById('searchDiscButton');
                if (searchDiscButton) {
                    searchDiscButton.addEventListener('click', triggerTracklistSearch);
                }

                function openDiscogsSearch() {
                    const title = document.getElementById('title')?.value.trim() || '';
                    const artist = document.getElementById('artist')?.value.trim() || '';
                    const q = [artist, title].filter(Boolean).join(' ').trim();
                    const targetUrl = q
                        ? `https://www.discogs.com/search/?q=${encodeURIComponent(q)}`
                        : 'https://www.discogs.com';
                    window.open(targetUrl, '_blank', 'noopener,noreferrer');
                }

                const getDiscInfoBtn = document.getElementById('getDiscInfoBtn');
                if (getDiscInfoBtn) {
                    getDiscInfoBtn.addEventListener('click', openDiscogsSearch);
                }

                ['artist', 'title'].forEach(id => {
                    const node = document.getElementById(id);
                    if (!node) return;
                    node.addEventListener('keydown', (event) => {
                        if (event.key === 'Enter') {
                            event.preventDefault();
                            triggerTracklistSearch();
                        }
                    });
                });

                document.addEventListener('cd:tracklist', async () => {
                    try {
                        console.log("addEventListener(cd:tracklist)")
                        const title = document.getElementById('title')?.value.trim() || "";
                        const artist = document.getElementById('artist')?.value.trim() || "";
                        const searchValue = [artist, title].filter(Boolean).join(' ').trim();
                        const myDiscTrackCount = parseMyDiscTrackCount(searchValue);

                        if (myDiscTrackCount) {
                            window.trackEditorTrackCountOverride = myDiscTrackCount;
                            openTrackEditor("1");
                            return;
                        }

                        addToHistory(ARTIST_HISTORY_KEY, artist);
                        addToHistory(TITLE_HISTORY_KEY, title);
                        refreshInputHistory();

                        const res = await fetch('/cddvd', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ action: 'tracklist', query: title, queryArtist: artist })
                        });

                        let data = await res.json();
                        console.log(data)
                        if (data.error) {
                            document.getElementById("tracklistOutput").innerHTML = `<p class="text-danger">Error: ${data.error}</p>`;
                            return;
                        }
                        // Parse potentially double-encoded string
                        if (typeof data === 'string') {
                            try { data = JSON.parse(data); } catch (e) { }
                        }

                        const tracks = data.tracks;
                        window.allTracks = tracks;
                        window.currentVisibleTracks = tracks;
                        window.manualTracklistSubmitted = false;
                        window.manualDiscTitle = "";
                        if (!Array.isArray(tracks) || tracks.length === 0) {
                            document.getElementById("tracklistOutput").innerHTML = "<p class='text-muted text-center'>No tracks found.</p>";
                            return;
                        }

                        // Disc Selector logic
                        const discSelector = document.getElementById("discSelector");
                        const discs = [...new Set(tracks.map(t => t.disc))].sort((a, b) => a - b);
                        discSelector.innerHTML = '<option value="all">All Discs</option>';
                        if (discs.length > 1) {
                            discs.forEach(disc => {
                                const opt = document.createElement("option");
                                opt.value = String(disc);
                                opt.textContent = `CD ${disc}`;
                                discSelector.appendChild(opt);
                            });
                            discSelector.style.display = "inline-block";
                        } else {
                            discSelector.style.display = "none";
                        }

                        discSelector.addEventListener("change", function () {
                            const selected = this.value;

                            if (!window.allTracks) return;

                            if (selected === "all") {
                                window.currentVisibleTracks = window.allTracks;
                                renderTracklist(window.allTracks);
                            } else {
                                const filtered = window.allTracks.filter(t => String(t.disc) === selected);
                                window.currentVisibleTracks = filtered;
                                renderTracklist(filtered);
                            }
                        });

                        renderTracklist(tracks);

                        const currentImages = data.images || [];
                        applyImagesToPreview(currentImages);
                        const titleNode = document.getElementById("discogsTrueTitel");
                        if (titleNode) {
                            titleNode.textContent = (data.discogsTitel && data.discogsTitel !== "empty")
                                ? data.discogsTitel
                                : "";
                        }

                    } catch (err) {
                        console.error("Tracklist failed:", err);
                        document.getElementById("tracklistOutput").innerHTML = `<p class="text-danger">Failed to load: ${err.message}</p>`;
                    }
                });
                // Auto-load when page opens
                document.dispatchEvent(new CustomEvent('cd:tracklist'));

                function prepareCapture() {
                    const hidden = document.getElementById("tracklistJson");
                    const hiddenDisc = document.getElementById("selectedDisc");
                    const hiddenTitle = document.getElementById("discTitle");
                    const discSelector = document.getElementById("discSelector");

                    if (window.manualTracklistSubmitted) {
                        const manualTracks = Array.isArray(window.currentVisibleTracks) && window.currentVisibleTracks.length > 0
                            ? window.currentVisibleTracks
                            : (Array.isArray(window.allTracks) ? window.allTracks : []);
                        if (hiddenDisc) hiddenDisc.value = "1";
                        if (hidden) hidden.value = JSON.stringify(manualTracks);
                        if (hiddenTitle) hiddenTitle.value = String(window.manualDiscTitle || "").trim();
                        return true;
                    }

                    if (hiddenDisc) {
                        hiddenDisc.value = discSelector ? discSelector.value : "all";
                    }
                    if (hiddenTitle) {
                        hiddenTitle.value = "";
                    }

                    if (!discSelector || discSelector.value === "all") {
                        hidden.value = "";
                        return true;
                    }

                    if (window.currentVisibleTracks) {
                        hidden.value = JSON.stringify(window.currentVisibleTracks);
                    }

                    return true;
                }

                function buildCapturePayload() {
                    if (window.manualTracklistSubmitted) {
                        const manualTracks = Array.isArray(window.currentVisibleTracks) && window.currentVisibleTracks.length > 0
                            ? window.currentVisibleTracks
                            : (Array.isArray(window.allTracks) ? window.allTracks : []);
                        return {
                            capture: "capture",
                            selectedDisc: "1",
                            tracklistJson: JSON.stringify(manualTracks),
                            discTitle: String(window.manualDiscTitle || "").trim()
                        };
                    }

                    const discSelector = document.getElementById("discSelector");
                    const selectedDisc = discSelector ? discSelector.value : "all";
                    const payload = {
                        capture: "capture",
                        selectedDisc
                    };

                    if (selectedDisc !== "all" && Array.isArray(window.currentVisibleTracks) && window.currentVisibleTracks.length > 0) {
                        payload.tracklistJson = JSON.stringify(window.currentVisibleTracks);
                    }

                    return payload;
                }
                function updateCurrentTrack(trackNum) {
                    lastTrack = trackNum;
                    document.querySelectorAll(".track-item").forEach(li => {
                        const num = Number(li.dataset.trackNum);
                        li.classList.toggle("active", num === trackNum);
                    });

                    // Restore Sync with CDControls if available
                    if (window.cdInstance) {
                        window.cdInstance.setTrack(trackNum);
                    }
                }

                function escapeHtml(value) {
                    return String(value || "")
                        .replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;")
                        .replace(/"/g, "&quot;")
                        .replace(/'/g, "&#39;");
                }

                function isNothingFoundTrack(title) {
                    return /nothing\s*found/i.test(String(title || ""));
                }

                function buildTonboxDefaultTitle() {
                    const now = new Date();
                    const weekday = now.toLocaleDateString('en-US', { weekday: 'short' });
                    const day = now.getDate();
                    const month = now.toLocaleDateString('en-US', { month: 'short' });
                    const time = now.toLocaleTimeString('en-GB', { hour12: false });
                    const year = now.getFullYear();
                    return `Tonbox-${weekday} ${day} ${month} ${time} ${year}`;
                }

                function getEditorTrackCount() {
                    const overrideTrackCount = Number(window.trackEditorTrackCountOverride);
                    if (Number.isFinite(overrideTrackCount) && overrideTrackCount > 0) {
                        return Math.min(Math.floor(overrideTrackCount), 50);
                    }

                    const fromDiscInfo = Number(discInfo && discInfo.tracks);
                    if (Number.isFinite(fromDiscInfo) && fromDiscInfo > 0) {
                        return fromDiscInfo;
                    }
                    return 0;
                }

                function closeTrackEditor() {
                    const modal = document.getElementById("trackEditorModal");
                    if (modal) modal.style.display = "none";
                    delete window.trackEditorTrackCountOverride;
                }

                async function uploadEditorImages() {
                    const image1Input = document.getElementById("editorImage1");
                    const image2Input = document.getElementById("editorImage2");
                    const file1 = image1Input && image1Input.files ? image1Input.files[0] : null;
                    const file2 = image2Input && image2Input.files ? image2Input.files[0] : null;

                    if (!file1 && !file2) {
                        return;
                    }

                    const fd = new FormData();
                    if (file1) fd.append("image1", file1);
                    if (file2) fd.append("image2", file2);

                    const response = await fetch('/cddvd/editor-images', {
                        method: 'POST',
                        body: fd
                    });
                    const payload = await response.json();
                    if (!response.ok || !payload.ok) {
                        throw new Error(payload && payload.error ? payload.error : 'image upload failed');
                    }

                    if (Array.isArray(payload.images)) {
                        applyImagesToPreview(payload.images);
                    }
                }

                function openTrackEditor(targetDisc) {
                    const modal = document.getElementById("trackEditorModal");
                    const grid = document.getElementById("trackEditorGrid");
                    const titleInput = document.getElementById("editorAlbumTitle");
                    if (!modal || !grid || !titleInput) return;

                    const editorTrackCount = getEditorTrackCount();
                    if (editorTrackCount <= 0) {
                        alert("No disc");
                        return;
                    }

                    const discSelector = document.getElementById("discSelector");
                    const selectedDisc = String(targetDisc || (discSelector ? discSelector.value : "1") || "1");
                    const normalizedDisc = selectedDisc === "all" ? "1" : selectedDisc;

                    const discTracks = (Array.isArray(window.allTracks) ? window.allTracks : [])
                        .filter(t => String(t.disc || "1") === normalizedDisc);

                    titleInput.value = buildTonboxDefaultTitle();
                    titleInput.dataset.disc = normalizedDisc;

                    let html = "";
                    for (let i = 1; i <= editorTrackCount; i++) {
                        const existing = discTracks.find(t => Number(t.track) === i);
                        let existingTitle = existing ? String(existing.title || "").replace(/^\d+\-\d+\s*/, "") : "";
                        if (isNothingFoundTrack(existingTitle)) {
                            existingTitle = `track${i}`;
                        }
                        html += `<input type="text" name="track${i}" data-track-index="${i}" placeholder="track${i}" value="${escapeHtml(existingTitle)}">`;
                    }
                    grid.innerHTML = html;
                    modal.style.display = "block";
                }

                function applyTrackEditorTracks(disc, albumTitle, manualTracks) {
                    if (!Array.isArray(manualTracks) || manualTracks.length === 0) {
                        alert("Please provide at least one track title.");
                        return;
                    }

                    const forcedDisc = "1";
                    const normalizedManualTracks = manualTracks.map((t, idx) => {
                        const trackNo = Number(t.track) || (idx + 1);
                        const titleText = String(t.title || "").replace(/^\d+\-\d+\s*/, "");
                        return {
                            disc: forcedDisc,
                            track: trackNo,
                            title: `${forcedDisc}-${trackNo} ${titleText}`,
                            duration: t.duration || ""
                        };
                    });

                    const existingAll = Array.isArray(window.allTracks) ? window.allTracks : [];
                    const otherDiscs = existingAll.filter(t => String(t.disc || "1") !== forcedDisc);
                    window.allTracks = otherDiscs.concat(normalizedManualTracks);
                    window.currentVisibleTracks = normalizedManualTracks;
                    window.manualTracklistSubmitted = true;

                    const discSelector = document.getElementById("discSelector");
                    if (discSelector) {
                        discSelector.innerHTML = '<option value="1">CD 1</option>';
                        discSelector.value = "1";
                        discSelector.style.display = "none";
                    }

                    const hiddenDisc = document.getElementById("selectedDisc");
                    if (hiddenDisc) hiddenDisc.value = "1";
                    const hiddenTracks = document.getElementById("tracklistJson");
                    if (hiddenTracks) hiddenTracks.value = JSON.stringify(normalizedManualTracks);

                    const discTitleNode = document.getElementById("discogsTrueTitel");
                    if (discTitleNode && albumTitle) {
                        discTitleNode.textContent = albumTitle;
                    }
                    window.manualDiscTitle = String(albumTitle || "").trim();
                    delete window.trackEditorTrackCountOverride;

                    renderTracklist(window.currentVisibleTracks);
                    closeTrackEditor();
                }

                async function submitTrackEditor() {
                    const titleInput = document.getElementById("editorAlbumTitle");
                    const grid = document.getElementById("trackEditorGrid");
                    if (!titleInput || !grid) return;

                    const disc = String(titleInput.dataset.disc || "1");
                    const albumTitle = (titleInput.value || "").trim();
                    const inputs = Array.from(grid.querySelectorAll("input[data-track-index]"));

                    const manualTracks = inputs
                        .map((input, idx) => ({
                            track: idx + 1,
                            text: (input.value || "").trim()
                        }))
                        .filter(item => item.text.length > 0)
                        .slice(0, getEditorTrackCount())
                        .map(item => ({
                            disc,
                            track: item.track,
                            title: `${disc}-${item.track} ${item.text}`,
                            duration: ""
                        }));

                    try {
                        await uploadEditorImages();
                    } catch (err) {
                        alert("Image upload failed: " + (err && err.message ? err.message : err));
                        return;
                    }

                    applyTrackEditorTracks(disc, albumTitle, manualTracks);
                }

                async function useDefaultTrackEditor() {
                    const titleInput = document.getElementById("editorAlbumTitle");
                    if (!titleInput) return;

                    const disc = String(titleInput.dataset.disc || "1");
                    const albumTitle = (titleInput.value || "").trim();
                    const editorTrackCount = getEditorTrackCount();
                    const manualTracks = [];
                    for (let i = 1; i <= editorTrackCount; i++) {
                        manualTracks.push({
                            disc,
                            track: i,
                            title: `${disc}-${i} track${i}`,
                            duration: ""
                        });
                    }

                    try {
                        await uploadEditorImages();
                    } catch (err) {
                        alert("Image upload failed: " + (err && err.message ? err.message : err));
                        return;
                    }

                    applyTrackEditorTracks(disc, albumTitle, manualTracks);
                }

                window.closeTrackEditor = closeTrackEditor;
                window.submitTrackEditor = submitTrackEditor;
                window.useDefaultTrackEditor = useDefaultTrackEditor;

                function renderTracklist(tracksToRender) {
                    let html = "<ul class='track-list'>";
                    tracksToRender.forEach(t => {
                        const key = `${t.disc}-${t.track}`;
                        const nothingFound = isNothingFoundTrack(t.title);
                        const safeTitle = escapeHtml(t.title);
                        const titleCell = nothingFound
                            ? `<button type="button" class="nothing-found-btn" data-action="edit-nothing-found" data-disc="${escapeHtml(t.disc)}">${safeTitle}</button>`
                            : safeTitle;
                        html += `
                            <li class="track-item"
                                data-track="${key}"
                                data-track-num="${t.track}"
                                data-disc="${t.disc}">
                                <div class="d-flex justify-content-between w-100">
                                    <span>${titleCell}</span>
                                    <span class="text-muted small">${t.duration || ''}</span>
                                </div>
                            </li>`;
                    });
                    html += "</ul>";
                    document.getElementById("tracklistOutput").innerHTML = html;
                }

                function clearClientCdState() {
                    window.allTracks = [];
                    window.currentVisibleTracks = [];
                    window.manualTracklistSubmitted = false;
                    window.manualDiscTitle = "";
                    const out = document.getElementById("tracklistOutput");
                    if (out) {
                        out.innerHTML = "<p class='text-muted text-center mt-5'>No tracklist loaded.</p>";
                    }

                    const titleNode = document.getElementById("discogsTrueTitel");
                    if (titleNode) titleNode.textContent = "";

                    const discSelector = document.getElementById("discSelector");
                    if (discSelector) {
                        discSelector.innerHTML = '<option value="all">All Discs</option>';
                        discSelector.style.display = "none";
                    }

                    for (let i = 1; i <= 21; i++) {
                        const img = document.getElementById(`img${i}`);
                        if (img) {
                            img.removeAttribute("src");
                            img.style.display = "none";
                        }
                    }
                }
 
                // Click handler for track items
                document.getElementById("tracklistOutput").addEventListener("click", e => {
                    const editBtn = e.target.closest('[data-action="edit-nothing-found"]');
                    if (editBtn) {
                        e.preventDefault();
                        e.stopPropagation();
                        openTrackEditor(editBtn.dataset.disc || "1");
                        return;
                    }

                    const li = e.target.closest(".track-item");
                    if (!li) return;
                    const trackKey = li.dataset.track;
                    const trackNum = Number(li.dataset.trackNum);

                    // Dispatch play event
                    document.dispatchEvent(new CustomEvent('cd:playtrack', { detail: { trackKey, trackNum } }));
                    updateCurrentTrack(trackNum);
                });

                // Listeners for CD Actions (fetch calls)
                document.addEventListener('cd:eject', async () => {
                    try {
                        await fetch('/cddvd', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ action: 'eject' })
                        });
                    } finally {
                        clearClientCdState();
                    }
                });

                document.addEventListener('cd:stop', async () => {
                    await fetch('/cddvd', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'stop' }) });
                    updateCurrentTrack(null);
                });

                document.addEventListener('cd:play', async () => {
                    const res = await fetch('/cddvd', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'play' }) });
                    const data = await res.json();
                    // Check for double-encoded JSON just in case
                    const parsedContext = (typeof data === 'string') ? JSON.parse(data) : data;
                    if (parsedContext.currentTrack != null) updateCurrentTrack(parsedContext.currentTrack);
                });

                document.addEventListener('cd:next', async () => {
                    const res = await fetch('/cddvd', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'next' }) });
                    const data = await res.json();
                    const parsedContext = (typeof data === 'string') ? JSON.parse(data) : data;
                    if (parsedContext.currentTrack != null) updateCurrentTrack(parsedContext.currentTrack);
                });

                document.addEventListener('cd:prev', async () => {
                    const res = await fetch('/cddvd', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'prev' }) });
                    const data = await res.json();
                    const parsedContext = (typeof data === 'string') ? JSON.parse(data) : data;
                    if (parsedContext.currentTrack != null) updateCurrentTrack(parsedContext.currentTrack);
                });

                document.addEventListener('cd:playtrack', async (e) => {
                    const { trackKey, trackNum } = e.detail;
                    const res = await fetch('/cddvd', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'playTrack', track: trackNum, trackKey: trackKey })
                    });
                    const data = await res.json();
                    const parsedContext = (typeof data === 'string') ? JSON.parse(data) : data;
                    //if (parsedContext.currentTrack != null) updateCurrentTrack(parsedContext.currentTrack);
                });

                // Polling
                let cdIntervalState = setInterval(async () => {
                    try {
                        const res = await fetch('/cdplayerStatus');
                        const data = await res.json();
                        const parsedContext = (typeof data === 'string') ? JSON.parse(data) : data;

                        if (parsedContext.currentTrack !== undefined && parsedContext.currentTrack !== lastTrack) {
                            updateCurrentTrack(parsedContext.currentTrack);
                        }
                    } catch (e) { }
                }, 2000);


                // const discSelector = document.getElementById("discSelector");
                // const hiddenDiscInput = document.getElementById("selectedDisc");

                // if (discSelector) {
                //     discSelector.addEventListener("change", function () {
                //         hiddenDiscInput.value = this.value;
                //     });
                // }
                // hiddenDiscInput.value = discSelector.value;

                window.addEventListener('beforeunload', () => {
                    console.log("clearInterval(cdIntervalState)")
                    clearInterval(cdIntervalState);
                });
