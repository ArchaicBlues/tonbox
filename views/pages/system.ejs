        <p id="ua"></p>
        <script>
            let audioApi=true
            document.write(navigator.userAgent); 
            var ua = document.getElementById("ua")
            ua.style.color = "red"
            if (navigator.userAgent.match("SamsungBrowser/27")) {
                audioApi = false
                console.log("Web Audio API not supported");
            }
            if (navigator.userAgent.match("Chrome/125")) {
                audioApi = false
                console.log("Web Audio API not supported");
            }
            if (navigator.userAgent.match("Firefox")){ 
                if ('webkitAudioContext' in window || 'AudioContext' in window) {
                    console.log('Web Audio API should be ok');
                } else {
                    audioApi = false
                    console.log('Web Audio API may not be enabled')
                    ua.innerHTML = '<b>Web Audio API not enabled in Firefox Browser ! </b>'
                }
            }
            if (!audioApi){
                if (!ua.innerHTML.match('Web Audio API not enabled'))
                    // ua.innerHTML += "<b>Dieser Browser hat möglicherweise \
                    // kein Web Audio API integriert! Equalizer und FrequenzBars könnten nicht funktionieren. \
                    // Benutze den FIREFOX Browser</b>"
                    ua.innerHTML += "<b>This Browser may have not \
                    a Web Audio API ! Equalizer and Frequency-Bars may not work. \
                    Use Mozilla / Firefox Browser</b>"
            }else{
                if (!ua.innerHTML.match('Web Audio API not enabled in your Web-Browser'))
                    ua.innerHTML += '<b>Web Audio API ok</b>'
            }
        </script>
