    <style>
    .audio-system-card {
        background: rgba(20, 20, 40, 0.9);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        padding: 15px 20px;
        max-width: 400px;
        font-family: 'Inter', sans-serif;
        color: white;
    }

    .audio-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 10px;
    }

    .audio-option {
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        padding: 8px 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }

    .audio-option:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .audio-option input[type="radio"] {
        display: none; /* hide the default radio button */
    }

    .audio-option span {
        position: relative;
        padding-left: 28px;
    }

    .audio-option span::before {
        content: "";
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        border: 2px solid #0ff;
        border-radius: 50%;
        background: transparent;
        transition: all 0.2s;
    }

    .audio-option input[type="radio"]:checked + span::before {
        background: #0ff;
        box-shadow: 0 0 5px #0ff;
    }


    .wifi-card {
        background: rgba(20, 20, 40, 0.95);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        padding: 20px 25px;
        max-width: 400px;
        margin: 0 auto 20px auto;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        font-family: 'Inter', sans-serif;
        color: white;
    }

    .wifi-card h4 {
        margin-bottom: 15px;
        color: var(--accent-color);
    }

    .wifi-inputs {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 20px;
        text-align: left;
    }

    .wifi-inputs label {
        font-size: 0.9rem;
        margin-bottom: 4px;
        display: block;
        color: #ccc;
    }

    .wifi-input {
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.2);
        background: rgba(255,255,255,0.05);
        color: white;
        font-size: 1rem;
        transition: all 0.2s;
        width: 100%;
    }

    .wifi-input:focus {
        outline: none;
        border-color: var(--accent-color);
        box-shadow: 0 0 8px var(--accent-color);
        background: rgba(255,255,255,0.1);
    }

    .wifi-actions {
        display: flex;
        justify-content: center;
    }

    .wifi-btn {
        background: var(--accent-color);
        color: black;
        border: none;
        padding: 10px 25px;
        border-radius: 25px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .wifi-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,255,255,0.4);
    }

/*************API Keys**************/
.card { max-width:600px; margin:auto; background:#1e1e1e; padding:30px; border-radius:8px; }
h2 { margin-top:0; }
label { display:block; margin-top:20px; }
input { width:100%; padding:8px; margin-top:5px; border-radius:4px; border:none; }
button { margin-top:25px; padding:10px 20px; border:none; border-radius:4px; cursor:pointer; }
.primary { background:#4CAF50; color:white; }
.test { background:#2196F3; color:white; margin-left:10px; }
.notice { font-size:0.9em; color:#bbb; margin-top:10px; }
.success { color:#4CAF50; margin-top:15px; }
.error { color:#f44336; margin-top:15px; }
.small-text {
  font-size: 10px;     /* kleiner */
  font-weight: normal; /* kein bold */
}

.tv-results {
    margin-top: 12px;
    display: grid;
    gap: 10px;
}

.tv-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    padding: 10px 12px;
}

.tv-title {
    font-weight: 600;
    color: #fff;
    font-size: 0.95rem;
}

.tv-meta {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.8rem;
    margin-top: 4px;
}

.tv-cap-list {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.tv-cap {
    border-radius: 999px;
    padding: 3px 8px;
    font-size: 0.72rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
}

.tv-cap-ok {
    border-color: rgba(78, 198, 116, 0.65);
    background: rgba(78, 198, 116, 0.18);
    color: #dbffe7;
}

.tv-cap-off {
    opacity: 0.72;
}

.tv-empty {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.85rem;
}

</style>
