    <main class="container">
        <form action='../system', method='POST', content-type="text/javascript">
        <button class="btn-modern" type="submit" name="Back" value="Back"><i class="bi bi-arrow-left"></i> Back / Submit</button>
        <br><br>
        <hr style="border-color:rgb(236, 6, 6)">
        <div class="audio-system-card">
            <b>Set Audio System:</b>
            <div class="audio-options">
                <!-- HTTP Web Option -->
                <label class="audio-option">
                    <input type="radio"
                        name="mediaSet"
                        value="HTTP live streaming"
                        <%= String(settings.mediaOut).includes("HTTP") ? "checked" : "" %>>
                    <span>HTTP Web</span>
                </label>

                <!-- Line-Out Options DAC / RPI-->
                <% for (var i = 0; i < audio.length; i++) { %>
                    <label class="audio-option">
                        <input type="radio" 
                            name="mediaSet"
                            value="<%- i %>" 
                            <%= i === Number(settings.mediaOut) ? "checked" : "" %>>
                        <span>Line-Out <%- audio[i] %></span>
                    </label>
                <% } %>
            </div>
        </div>

        <hr style="border-color:rgb(236, 6, 6)">
            <button class="btn-primary" type="submit" id="theme-toggle" name='sys' value="DESIGN" style="font-size:1.0rem">Change View</button>&nbsp;&nbsp;
            <br><br>
            <button class="btn-primary" type="submit" name='sys' value="CHECKTV" style="font-size:1.0rem">Check TV</button>
            <div class="tv-results">
                <%
                    const tvData = Array.isArray(resultTV) ? resultTV : [];
                    const capOrder = [
                        'dlnaRenderer', 'dlnaServer', 'avTransport', 'setAVTransportURI', 'setNextAVTransportURI',
                        'play', 'stop', 'pause', 'seek', 'next', 'previous', 'webUriPlayable',
                        'dial', 'samsungRemoteControl', 'samsungMainTVAgent', 'chromecast', 'airplay'
                    ];
                %>
                <% if (tvData.length === 0) { %>
                    <div class="tv-empty">No TV data yet. Click "Check TV".</div>
                    <div class="tv-empty">Browser-Spiegelung "Media Show" an TV nicht möglich</div>
                <% } else { %>
                    <div class="tv-empty">Smart View auf TV möglich</div>
                    <% for (let i = 0; i < tvData.length; i++) { %>
                        <% const tv = tvData[i] || {}; %>
                        <% const caps = tv.capabilities && typeof tv.capabilities === 'object' ? tv.capabilities : {}; %>
                        <% const avTransport = tv.protocols && tv.protocols.avTransport && typeof tv.protocols.avTransport === 'object' ? tv.protocols.avTransport : {}; %>
                        <% const avTransportActions = Array.isArray(avTransport.actions) ? avTransport.actions : []; %>
                        <% const avActionSet = new Set(avTransportActions); %>
                        <% const normalizedCaps = Object.assign({}, caps, {
                            avTransport: avTransportActions.length > 0,
                            setAVTransportURI: avActionSet.has('SetAVTransportURI'),
                            setNextAVTransportURI: avActionSet.has('SetNextAVTransportURI'),
                            play: avActionSet.has('Play'),
                            stop: avActionSet.has('Stop'),
                            pause: avActionSet.has('Pause'),
                            seek: avActionSet.has('Seek'),
                            next: avActionSet.has('Next'),
                            previous: avActionSet.has('Previous')
                        }); %>
                        <% const avTransportCapOrder = [
                            'avTransport', 'setAVTransportURI', 'setNextAVTransportURI',
                            'play', 'stop', 'pause', 'seek', 'next', 'previous'
                        ]; %>
                        <div class="tv-card">
                            <div class="tv-title"><%- tv.name || 'Unknown device' %></div>
                            <div class="tv-meta">IP: <%- tv.ip || '-' %> | <%- tv.manufacturer || '-' %> | <%- tv.model || '-' %></div>
                            <div class="tv-meta">Recommended: <%- tv.recommended || '-' %></div>
                            <div class="tv-meta">AVTransport: <%- avTransport.serviceType || '-' %></div>
                            <div class="tv-meta">Control URL: <%- avTransport.controlURL || '-' %></div>
                            <div class="tv-meta">Event Sub URL: <%- avTransport.eventSubURL || '-' %></div>
                            <div class="tv-meta">SCPD URL: <%- avTransport.SCPDURL || '-' %></div>
                            <div class="tv-cap-list">
                                <% if (avTransportActions.length === 0) { %>
                                    <span class="tv-cap tv-cap-off">actions: none</span>
                                <% } else { %>
                                    <% for (let a = 0; a < avTransportActions.length; a++) { %>
                                        <span class="tv-cap tv-cap-ok"><%- avTransportActions[a] %></span>
                                    <% } %>
                                <% } %>
                            </div>
                            <div class="tv-cap-list">
                                <% for (let c = 0; c < avTransportCapOrder.length; c++) { %>
                                    <% const key = avTransportCapOrder[c]; %>
                                    <% const enabled = !!normalizedCaps[key]; %>
                                    <span class="tv-cap <%- enabled ? 'tv-cap-ok' : 'tv-cap-off' %>"><%- key %>: <%- enabled ? 'true' : 'false' %></span>
                                <% } %>
                            </div>
                            <div class="tv-cap-list">
                                <% for (let c = 0; c < capOrder.length; c++) { %>
                                    <% const key = capOrder[c]; %>
                                    <% const enabled = !!normalizedCaps[key]; %>
                                    <span class="tv-cap <%- enabled ? 'tv-cap-ok' : 'tv-cap-off' %>"><%- key %>: <%- enabled ? 'true' : 'false' %></span>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                <% } %>
            </div>
            <br><br>
        <hr style="border-color:rgb(236, 6, 6)"><br>
        <br>
        </form>
        
