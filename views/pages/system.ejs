<script>
// Save button click handler – sends only the API keys
document.getElementById("saveApiKeysBtn").addEventListener("click", async function() {
    const youtubeKey = document.getElementById("youtubeKey").value.trim();
    const discogsToken = document.getElementById("discogsUserToken").value.trim();

    // if (!youtubeKey || !discogsKey) {
    //     showStatus("Bitte alle Pflichtfelder ausfüllen.", false);
    //     return;
    // }

    try {
        const response = await fetch("/apiKeySet", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                youtubeKey: youtubeKey,
                discogsUserToken: discogsToken
                // If you later uncomment songrecHost, add it here
            })
        });
        
        if (response.ok) {
            // Optionally read the response body (if your server sends JSON back)
            const data = await response.json();
            console.log("Server response:", data);
            showStatus("youtube Key = "+data.youtubeKey+" / discogs User Token = "+data.discogsUserToken)
        } else {
            // Try to get error message from response
            let errorMsg = "Fehler beim Speichern. (Status: " + response.status + ")";
            try {
                const errorData = await response.json();
                if (errorData.message) errorMsg += " - " + errorData.message;
            } catch (e) {
                // Ignore if response is not JSON
            }
            showStatus(errorMsg, false);
        }
    } catch (err) {
        showStatus("Fehler beim Speichern: " + err.message, false);
    }
});

// Status helper (reused from your original code)
function showStatus(message, success) {
    const status = document.getElementById("status");
    status.className = success ? "success" : "error";
    let msg = message.split("/")
    let inf1="YouTube Key ok, confirmed and saved"
    let inf2 ="Discogs User Token ok, confirmed and saved"
    if (msg[0].match("nok")) inf1=" no valid YouTube Key - not saved !"
    if (msg[1].match("nok")) inf2=" not valid Discogs User Token - not saved !"
    status.innerText = inf1+"\n"+inf2;
}

function togglePassword() {
    const passInput = document.getElementById("pass");
    if (passInput.type === "password") {
        passInput.type = "text";
    } else {
        passInput.type = "password";
    }
}
</script>    
<script>
document.addEventListener('DOMContentLoaded', () => {
    const themeBtn = document.getElementById('theme-toggle');
    if (!themeBtn) return;

    // Reihenfolge: Modern -> Vintage -> Sci-Fi -> Inverse -> (zurück zu Modern)
    const themes = ['modern', 'vintage', 'sci-fi'];

    themeBtn.addEventListener('click', () => {
      let current = localStorage.getItem('theme') || 'modern';
      let nextIndex = (themes.indexOf(current) + 1) % themes.length;
      let nextTheme = themes[nextIndex];

      // Klassen am Body/HTML aktualisieren
      themes.forEach(t => document.body.classList.remove(t));
      if (nextTheme !== 'modern') {
          document.body.classList.add(nextTheme);
      }

      localStorage.setItem('theme', nextTheme);
      
      // Optisches Feedback auf dem Button
      const icons = {
          modern: 'fa-magic',
          vintage: 'fa-clock',
          'sci-fi': 'fa-rocket',
      };
      themeBtn.querySelector('i').className = 'fas ' + (icons[nextTheme] || 'fa-palette');
    });
  });
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const scrollKey = 'system-scroll-to-end-after-usb-action';

    const disconnectBtn = document.getElementById('usb-disconnect-btn');
    const initBtn = document.getElementById('usb-init-btn');

    const markForScroll = () => {
        sessionStorage.setItem(scrollKey, '1');
    };

    if (disconnectBtn) {
        disconnectBtn.addEventListener('click', markForScroll);
    }

    if (initBtn) {
        initBtn.addEventListener('click', markForScroll);
    }

    if (sessionStorage.getItem(scrollKey) === '1') {
        sessionStorage.removeItem(scrollKey);
        requestAnimationFrame(() => {
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        });
    }
});
</script>
