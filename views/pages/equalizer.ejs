		<script>
			var dummy
			var slider = document.getElementById("range");
			var x = document.getElementById("range").defaultValue;
			document.getElementById("range").innerHTML = x;
			let updateL = () => dummy = slider.value;
			slider.addEventListener('input', updateL);
			slider.onchange = function(event){
				var xhr = new XMLHttpRequest();
				xhr.open("GET", "/volume="+slider.value, true);
				xhr.send();
			}
