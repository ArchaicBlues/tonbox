<link rel=stylesheet type="text/css" href="views/css/style.css">
<style>
.checkbox-container input {
    display: none;
  }
  
  .checkbox-container .checkbox-indicator {
    display: inline-block;
    height: 20px;
    width: 20px;
    border: 3px solid #f70404;
    position: relative;
    margin-right: 3px;
    vertical-align: middle
  }
  
  .checkbox-container .checkbox-indicator:hover {
    border: 3px solid #0f1dd4;
  }
  
  .checkbox-container input:checked ~ .checkbox-indicator {
    background-color: rgb(249, 5, 34);
    box-shadow: 0 0 0 3px #f00202 inset;
  }

  img.custom:hover,
	img.custom:focus {
  	width: 20%;
  	height: auto;
	}

.input_btn {
  border: none;
    color:white;
  background-color: black;
  /* padding: 14px 28px; */
  font-size: 16px;
  cursor: pointer;
  display: inline-block;
}
.form-group {
  display: inline-block;
  width: auto;
}

.media-section {
    width: min(1100px, 96%);
    margin: 0 auto;
}

.media-collection {
    display: grid;
    gap: 10px;
}

.media-collection.is-grid {
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
}

.media-collection.is-slider {
    grid-template-columns: auto 1fr auto;
    align-items: center;
}

.media-slider-btn {
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    font-size: 1.3rem;
    line-height: 1;
}

.media-slider-btn:disabled {
    opacity: 0.35;
}

.media-slider-viewport {
    overflow-x: auto;
    scrollbar-width: thin;
    scroll-behavior: smooth;
}

.media-slider-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(170px, 1fr);
    gap: 10px;
}

.media-card {
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
}

.media-thumb {
    width: 100%;
    height: 86px;
    object-fit: cover;
    border-radius: 6px;
    background: #111;
}

.media-file-btn {
    width: 100%;
    max-width: 100%;
    font-size: 0.8rem;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.media-delete-label {
    font-size: 0.78rem;
    white-space: nowrap;
}

.media-meta {
    color: rgba(255,255,255,0.68);
    font-size: 0.72rem;
    text-align: center;
}

@media (max-width: 700px) {
    .media-slider-track {
        grid-auto-columns: minmax(145px, 1fr);
    }
}

.required {
  float: right;
  margin-left: 5px; /* adjust the spacing as needed */
}
/* 
.custom, .input_btn, .checkbox-container {
       margin-right: 10px;
} */
</style>


