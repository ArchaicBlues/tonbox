        <% const computedNextOffset = rd.length; %>
        <% const hasMoreStationsLocal = (locals && Object.prototype.hasOwnProperty.call(locals, 'hasMoreStations')) ? locals.hasMoreStations : undefined; %>
        <% const canShowMore = (typeof hasMoreStationsLocal === 'boolean') ? hasMoreStationsLocal : (computedNextOffset < totalStations); %>
        <div class="glass-panel p-3 mb-4 text-center">
            Found <%- Math.min(pageOffset + rd.length, totalStations) %> of <%- totalStations %>
