<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

        <!-- Leaflet & App Specifics -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
        <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
        <link rel="manifest" href="/manifest/manifest.json?v=2">
        <!-- Legacy Style for map or specific widgets if needed, but trying to override with modern -->
        <style>

            /* Specific Radio Page Styles */

            /* Map Container */
            #map {
                height: 300px;
                width: 100%;
                border-radius: 12px;
                z-index: 1;
                /*filter: brightness(0.85)*/
            }

            /* Glass Modal Overrides */
            .modal {
                display: none;
                position: fixed;
                z-index: 2000;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.6);
                backdrop-filter: blur(5px);
            }

            .modal-content {
                background: rgba(20, 20, 40, 0.95);
                margin: 5% auto;
                padding: 20px;
                width: 90%;
                max-width: 500px;
                border-radius: 16px;
                color: white;
                border: 1px solid var(--glass-border);
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            }

            .modal-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                padding-bottom: 10px;
            }

            .modal-list-item {
                width: 100%;
                padding: 12px 16px;
                margin: 4px 0;
                background: rgba(255, 255, 255, 0.05);
                color: white;
                border: 1px solid transparent;
                text-align: left;
                border-radius: 8px;
                font-size: 1rem;
                cursor: pointer;
                transition: all 0.2s;
            }

            .modal-list-item:hover {
                background: rgba(255, 255, 255, 0.1);
                transform: translateX(5px);
            }

            .close {
                color: #aaa;
                font-size: 28px;
                font-weight: bold;
                cursor: pointer;
                transition: color 0.2s;
            }

            .close:hover {
                color: white;
            }

            /* Filter Bar */
            .filter-bar {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
                gap: 1rem;
                margin-bottom: 1rem;
            }

            .filter-btn {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid var(--glass-border);
                color: white;
                padding: 0.8rem;
                border-radius: 8px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                transition: all 0.2s;
                font-size: 0.9rem;
            }

            .filter-btn:hover {
                background: rgba(255, 255, 255, 0.1);
                border-color: var(--accent-color);
            }

            .bitrate-row {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 0.75rem;
                margin-bottom: 1rem;
                color: rgba(255, 255, 255, 0.7);
                flex-wrap: wrap;
            }

            .search-inline-btn {
                margin-left: 0.5rem;
            }

/* Station List */
.station-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
gap: 0.6rem;
margin-top: 1rem;
max-height: 20vh;
/* Scrollable area */
overflow-y: auto;
padding-right: 5px;
}
.station-card {
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid var(--glass-border);
    border-radius: 8px;
    padding: 0.7rem;

    display: flex;
    flex-direction: column;   /* <-- wichtig */
    align-items: center;
    gap: 0.5rem;
}

.station-card small,
.station-card div[style*="font-size"] {
    font-size: 0.7rem;
}
.station-card.compact {
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
}

.station-card.compact .station-name {
    font-size: 0.8rem;
}

.station-name {
    display: block;
    width: 100%;
    max-width: 100%;
    text-align: center;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.play-btn-small {
    background: var(--accent-color);
    color: black;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.rec-btn-small {
    background: transparent;
    border: 1px solid #ff0055;
    color: #ff0055;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.7rem;
    cursor: pointer;
}

            .rec-btn-small:hover {
                background: #ff0055;
                color: white;
            }

.fav-title {
    width: 100%;
    text-align: center;
    font-weight: 600;
    color: white;
    overflow: hidden;
    text-overflow: ellipsis;
}
.fav-controls {
    display: flex;
    justify-content: center;
    gap: 1rem;
}

.station-actions {
    margin-top: 1rem;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.search-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
}


        </style>
</head>

<body>
    <%- include('../partials/header'); %>

        <!-- <main class="container animate-in"> -->
            <form action='../radioStation' method='POST' id="mainForm">

                <!-- Pass Server Variables to JS -->
                <script>
                    audioOut = JSON.stringify("<%- settings.mediaOut %>");
                    dirType = "Radio";
                    modalWin = true;
                    audioTag = true;
                    rd =<%- JSON.stringify(rd) %>;
                    let currentReverb = "<%= settings.reverb %>";
                    console.log("recording="+JSON.stringify("<%- recording %>"))
                </script>

                <!-- Top Controls: Volume & EQ -->
                <div class="glass-panel p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div style="flex: 1; min-width: 200px;">
                        <label
                            style="color: var(--text-muted); font-size: 0.8rem; display: block; margin-bottom: 0.5rem;"><i
                                class="bi bi-volume-up"></i> Volume</label>
                        <%if (settings.mediaOut.match("HTTP")) {%>
                            <input oninput="volumeWEB(this.value)" id="vol" type="range" step="1" min="0"
                                max="50" style="width:100%">
                            <%}else{%>
                                <input onchange="volumeRPI(this.value)" type="range" min="75" max="100" step="0.5"
                                    value="<%- vol %>" id="vol" style="width:100%">
                                <%}%>
                    </div>
                    <button type="button" class="btn-modern"
                        onclick="openEq()">
                        Eq
                    </button>
                </div>

                <!-- Filters -->
                <div class="glass-panel p-4 mb-4">
                    <!-- <h4 class="mb-3">Station Browser</h4> -->


                    <div class="filter-bar">
                        <!-- Country Filter -->
                        <button type="button" id="countryBtn" class="filter-btn"
                            onclick="openSelectionModal('country')">
                            <% if (search.country && search.country.includes(',')) { const
                                iso=search.country.split(',')[0].trim().toLowerCase(); %>
                                <img src="https://flagcdn.com/w40/<%= iso %>.png" width="20"
                                    style="border-radius: 2px;">
                                <span>
                                    <%= search.country %>
                                </span>
                                <% } else { %>
                                    <i class="bi bi-globe"></i>
                                    <%= search.country || 'Select Country' %>
                                        <% } %>
                        </button>
                        <input type="hidden" name="country" id="hiddenCountry" value="<%- search.country %>">

                        <!-- Genre Filter -->
                        <button type="button" id="genreBtn" class="filter-btn" onclick="openSelectionModal('genre')">
                            <i class="bi bi-music-note"></i>
                            <%= search.genre || 'Genre' %>
                        </button>
                        <input type="hidden" name="genre" id="hiddenGenre" value="<%- search.genre %>">

                        <!-- Name Filter -->
                        <input name="station" id="station" value="<%- search.station %>" placeholder="Stationname"
                            class="form-control"
                            style="background: rgba(0,0,0,0.3); border: 1px solid var(--glass-border); color: white; padding: 0.7rem;">
                    </div>

                    <!-- Bitrate Selection -->
                    <div class="bitrate-row">
                        <label><input type="radio" name="bitrate" value="all"> All</label>
                        <label><input type="radio" name="bitrate" value="128" checked> 128k</label>
                        <label><input type="radio" name="bitrate" value="192"> 192k</label>
                        <label><input type="radio" name="bitrate" value="320"> 320k</label>
                        <button id="searchBtn" class="btn-modern btn-primary search-inline-btn" type="submit">
                            <i class="bi bi-search"></i> 
                            <span id="btnText">Search Radiostation</span>
                        </button>
                    </div>

                    <% const topTotalStations = Number((locals && Object.prototype.hasOwnProperty.call(locals, 'dat')) ? locals.dat : (rd.length || 0)); %>
                    <% const topComputedNextOffset = rd.length; %>
                    <% const topHasMoreStationsLocal = (locals && Object.prototype.hasOwnProperty.call(locals, 'hasMoreStations')) ? locals.hasMoreStations : undefined; %>
                    <% const topCanShowMore = (typeof topHasMoreStationsLocal === 'boolean') ? topHasMoreStationsLocal : (topComputedNextOffset < topTotalStations); %>
                    <div class="search-actions">
                        <% if (topCanShowMore) { %>
                            <button class="btn-modern" type="submit" name="NextStations" value="<%- topComputedNextOffset %>">
                                Next <%- Math.min(50, Math.max(topTotalStations - topComputedNextOffset, 0)) %> Stations
                            </button>
                        <% } %>
                    </div>
                </div>

