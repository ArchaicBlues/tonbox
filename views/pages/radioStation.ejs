        <!-- Modals -->
        <!-- EQ Modal  -->
        <div id="eqModel" class="modal"
            style="display:none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 2000; background: rgba(0,0,0,0.6); backdrop-filter: blur(5px);">
            <div class="modal-content"
                style="background: rgba(72, 72, 75, 0.95); margin: 5% auto; padding: 20px; width: 90%; max-width: 400px; border-radius: 16px; border: 1px solid var(--glass-border);">
                <div class="d-flex justify-content-between mb-3">
                    <h5>Equalizer</h5>
                    <span class="close-btn" onclick="document.getElementById('eqModel').style.display='none'"
                        style="cursor:pointer; font-size: 1.5rem;">&times;</span>
                </div>
                <div id="eqForm">
                    <div class="mb-1 d-flex gap-1">
                        <label><input type="radio" name="eq" id="fIndex0" <%=(settings && settings.filterIndex==0)
                                ? 'checked' : '' %>> Clear</label>
                        <label><input type="radio" name="eq" id="fIndex1" <%=(settings && settings.filterIndex==1)
                                ? 'checked' : '' %>> Neutral</label>
                        <label><input type="radio" name="eq" id="fIndex2" <%=(settings && settings.filterIndex==2)
                                ? 'checked' : '' %>> Warm</label>
                        <label><input type="radio" name="eq" id="fIndex3" <%=(settings && settings.filterIndex==3)
                                ? 'checked' : '' %>> Bass</label>
                        <label><input type="radio" name="eq" id="fIndex4" <%=(settings && settings.filterIndex==4)
                                ? 'checked' : '' %>> My</label>
                    </div>
                    <div style="max-height:45vh; overflow-y:auto;">
                        <div class="eq-row">
                            <span class="eq-label">40  Hz</span>
                            <input id="40Hz" type="range" value="70.0" oninput="eqGain(this.value, '40Gain');"></input>
                        </div>
                        <div class="eq-row">
                            <span class="eq-label">121 Hz</span>
                            <input id="121Hz" type="range" value="51.4" oninput="eqGain(this.value, '121Gain');"></input>
                        </div>
                        <div class="eq-row">
                            <span class="eq-label">547 Hz</span>
                            <input id="547Hz" type="range" value="49.5" oninput="eqGain(this.value, '547Gain');"></input>
                        </div>
                        <div class="eq-row">
                            <span class="eq-label">674 Hz</span>
                            <input id="674Hz" type="range" value="47.0" oninput="eqGain(this.value, '674Gain');"></input>
                        </div>
                        <div class="eq-row">
                            <span class="eq-label">818 Hz</span>
                            <input id="818Hz" type="range" value="49.75" oninput="eqGain(this.value, '818Gain');"></input>
                        </div>
                        <div class="eq-row">
                            <span class="eq-label">1503Hz</span>
                            <input id="1503Hz" type="range" value="49.5" oninput="eqGain(this.value, '1503Gain');"></input>
                        </div>
                        <div class="eq-row">
                            <span class="eq-label">1605Hz</span>
                            <input id="1605Hz" type="range" value="54.5" oninput="eqGain(this.value, '1605Gain');"></input>
                        </div>
                        <div class="eq-row">
                            <span class="eq-label">1722Hz</span>
                            <input id="1722Hz" type="range" value="48.25" oninput="eqGain(this.value, '1722Gain');"></input>
                        </div>
                        <div class="eq-row">
                            <span class="eq-label">4160Hz</span>
                            <input id="4160Hz" type="range" value="50" oninput="eqGain(this.value, '4160Gain');"></input>
                        </div>
                        <div class="eq-row">
                            <span class="eq-label">12 kHz</span>
                            <input id="12000Hz" type="range" value="23.75" oninput="eqGain(this.value, '12000Gain');"></input>
                        </div>
                    </div>

                    <!-- Reverb Toggle (Form Submit) -->
                    <button class="btn-modern mt-3 w-100" id="reverbButton" type="button" onclick="toggleReverb()">
                        Toggle Reverb <%= (settings && settings.reverb === 'off') ? 'ON' : 'OFF' %>
                    </button>
                </div>
                <script>
                    function toggleReverb() {
                        const newValue = currentReverb === "off" ? "on" : "off";
                        fetch('/reverb', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ reverb: newValue })
                        })
                        .then(res => res.json())
                        .then(data => {

                            currentReverb = data.reverb;   // 🔥 update JS state

                            if (audioOut && audioOut.match("HTTP") && typeof applyReverbRouting === 'function') {
                                applyReverbRouting(currentReverb === "on");
                            }

                            const reverbBtn = document.getElementById('reverbButton');
                            if (reverbBtn) reverbBtn.textContent = 'Toggle Reverb ' + (currentReverb === "off" ? 'ON' : 'OFF');

                            document.getElementById('eqModel').style.display = 'none';
                        })
                        .catch(err => console.error("Reverb error:", err));
                    }
                </script>
            </div>
        </div>
        <!-- Selection Modal (Country/Genre) -->
        <div id="selectionModal" class="modal">
            <div class="modal-content" style="height: 80vh; display: flex; flex-direction: column;">
                <div class="modal-header">
                    <h3 id="modalTitle">Select</h3>
                    <span class="close-btn" onclick="closeSelectionModal()">&times;</span>
                </div>

                <input type="text" id="modalSearch" placeholder="Search..." onkeyup="filterModalList()"
                    class="form-control mb-3"
                    style="background: rgba(255,255,255,0.1); border:none; color:white;">

                <div id="selectionList" style="flex: 1; overflow-y: auto;"></div>

                <button type="button" class="btn-modern w-100 mt-3" onclick="clearSelection()">Clear
                    Selection</button>
            </div>
        </div>

        </form>
        <!-- </main> -->

        <script>
            /* ISO-3166 country centroids (lat/lon) */
            const COUNTRY_COORDS = {
            AF:{lat:33.9391,lon:67.7100}, AL:{lat:41.1533,lon:20.1683},
            DZ:{lat:28.0339,lon:1.6596},  AS:{lat:-14.2710,lon:-170.1322},
            AD:{lat:42.5063,lon:1.5218},  AO:{lat:-11.2027,lon:17.8739},
            AI:{lat:18.2206,lon:-63.0686}, AQ:{lat:-75.2509,lon:-0.0714},
            AG:{lat:17.0608,lon:-61.7964}, AR:{lat:-38.4161,lon:-63.6167},
            AM:{lat:40.0691,lon:45.0382},  AU:{lat:-25.2744,lon:133.7751},
            AT:{lat:47.5162,lon:14.5501},  AZ:{lat:40.1431,lon:47.5769},
            BS:{lat:25.0343,lon:-77.3963}, BH:{lat:26.0667,lon:50.5577},
            BD:{lat:23.6850,lon:90.3563},  BB:{lat:13.1939,lon:-59.5432},
            BY:{lat:53.7098,lon:27.9534},  BE:{lat:50.5039,lon:4.4699},
            BZ:{lat:17.1899,lon:-88.4976}, BJ:{lat:9.3077,lon:2.3158},
            BO:{lat:-16.2902,lon:-63.5887}, BR:{lat:-14.2350,lon:-51.9253},
            BG:{lat:42.7339,lon:25.4858},  CA:{lat:56.1304,lon:-106.3468},
            CH:{lat:46.8182,lon:8.2275},   CL:{lat:-35.6751,lon:-71.5430},
            CN:{lat:35.8617,lon:104.1954}, CO:{lat:4.5709,lon:-74.2973},
            CR:{lat:9.7489,lon:-83.7534},  CU:{lat:21.5218,lon:-77.7812},
            CZ:{lat:49.8175,lon:15.4730},  DE:{lat:51.1657,lon:10.4515},
            DK:{lat:56.2639,lon:9.5018},   DO:{lat:18.7357,lon:-70.1627},
            EC:{lat:-1.8312,lon:-78.1834}, EG:{lat:26.8206,lon:30.8025},
            ES:{lat:40.4637,lon:-3.7492},  EE:{lat:58.5953,lon:25.0136},
            FI:{lat:61.9241,lon:25.7482},  FR:{lat:46.2276,lon:2.2137},
            GB:{lat:55.3781,lon:-3.4360},  GR:{lat:39.0742,lon:21.8243},
            HU:{lat:47.1625,lon:19.5033},  IE:{lat:53.4129,lon:-8.2439},
            IL:{lat:31.0461,lon:34.8516},  IN:{lat:20.5937,lon:78.9629},
            IQ:{lat:33.2232,lon:43.6793},  IR:{lat:32.4279,lon:53.6880},
            IT:{lat:41.8719,lon:12.5674},  JP:{lat:36.2048,lon:138.2529},
            KR:{lat:35.9078,lon:127.7669}, MX:{lat:23.6345,lon:-102.5528},
            NL:{lat:52.1326,lon:5.2913},   NO:{lat:60.4720,lon:8.4689},
            NZ:{lat:-40.9006,lon:174.8860}, PL:{lat:51.9194,lon:19.1451},
            PT:{lat:39.3999,lon:-8.2245},  RO:{lat:45.9432,lon:24.9668},
            RU:{lat:61.5240,lon:105.3188}, SE:{lat:60.1282,lon:18.6435},
            TR:{lat:38.9637,lon:35.2433},  UA:{lat:48.3794,lon:31.1656},
            US:{lat:37.0902,lon:-95.7129}, ZA:{lat:-30.5595,lon:22.9375}
            };
                let activeMarker = null;
                let pulseInterval = null;
                let map = null;

                document.addEventListener("DOMContentLoaded", function () {
                    if (isIOS()) {
                        console.log("iOS device detected");
                        setPlatformDevice("iOS")
                        //debug2(" - iOS device detected")
                        map = L.map('map', {
                            dragging: true,
                            touchZoom: true,
                            scrollWheelZoom: false,
                            tap: true
                        }).setView([20, 0], 0, { animate: true });

                    } else 
                    if (isMobile()) {
                        console.log("Mobile device detected");
                        setPlatformDevice("Mobile")
                        //debug2(" - Mobile device detected")
                        map = L.map('map', {
                            dragging: true,
                            touchZoom: true,
                            scrollWheelZoom: false,
                            tap: true
                        }).setView([20, 0], 0,{animate:true});
                    } else {
                        console.log("PC detected");
                        setPlatformDevice("PC")
                        map = L.map('map', {
                            zoomControl: true,
                            dragging: true,
                            // touchZoom: true,     // pinch zoom INSIDE map
                            // scrollWheelZoom: false,
                            // doubleClickZoom: false,
                            // keyboard: false,
                            // tap: true
                        }).setView([20, 0], 0,{animate:true});
                    }
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '© OpenStreetMap'
                    }).addTo(map);
                    // L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                    //     attribution: '&copy; OpenStreetMap &copy; CARTO',
                    //     subdomains: 'abcd',
                    //     maxZoom: 19
                    // }).addTo(map);
                });

                // SELECTION MODAL LOGIC
                let currentType = '';
                function isIOS() {
                    return (
                        /iPad|iPhone|iPod/.test(navigator.userAgent) ||
                        (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
                    );
                }
                function openSelectionModal(type) {
                    currentType = type;
                    const modal = document.getElementById('selectionModal');
                    const list = document.getElementById('selectionList');
                    const searchInput = document.getElementById('modalSearch');

                    list.innerHTML = '';
                    searchInput.value = '';
                    document.getElementById('modalTitle').innerText = type === 'country' ? 'Select Country' : 'Select Genre';

                    const sourceId = type === 'country' ? 'countries' : 'genres';
                    const options = document.getElementById(sourceId).options;

                    for (let opt of options) {
                        let btn = document.createElement('div');
                        btn.className = 'modal-list-item';
                        btn.style.display = 'flex';
                        btn.style.alignItems = 'center';
                        btn.style.gap = '10px';

                        let visibleText = opt.value;
                        if (type === 'country' && opt.value.includes(',')) {
                            const isoCode = opt.value.split(',')[0].trim().toLowerCase();
                            if (isoCode.length === 2) {
                                let img = document.createElement('img');
                                img.src = `https://flagcdn.com/w40/${isoCode}.png`;
                                img.width = 24;
                                img.style.borderRadius = "2px";
                                btn.appendChild(img);
                            }
                        }

                        let span = document.createElement('span');
                        span.innerText = visibleText;
                        btn.appendChild(span);

                        btn.onclick = () => selectValue(opt.value);
                        list.appendChild(btn);
                    }
                    modal.style.display = 'block';
                    setTimeout(() => searchInput.focus(), 100);
                }

                function filterModalList() {
                    const val = document.getElementById('modalSearch').value.toUpperCase();
                    const btns = document.getElementById('selectionList').getElementsByClassName('modal-list-item');
                    for (let b of btns) {
                        b.style.display = b.innerText.toUpperCase().includes(val) ? 'flex' : 'none';
                    }
                }

                function selectValue(val) {
                    if (currentType === 'country') {
                        document.getElementById('hiddenCountry').value = val;
                        const btn = document.getElementById('countryBtn');
                        if (val && val.includes(',')) {
                            const iso = val.split(',')[0].trim().toLowerCase();
                            btn.innerHTML = `<img src="https://flagcdn.com/w40/${iso}.png" width="20" style="margin-right: 5px;"> ${val}`;
                        } else {
                            btn.innerHTML = '<i class="bi bi-globe"></i> ' + (val || 'Select Country');
                        }
                    } else {
                        document.getElementById('hiddenGenre').value = val;
                        document.getElementById('genreBtn').innerHTML = '<i class="bi bi-music-note"></i> ' + (val || 'Select Genre');
                    }
                    closeSelectionModal();
                }

                function clearSelection() {
                    selectValue('');
                }

                function closeSelectionModal() {
                    document.getElementById('selectionModal').style.display = 'none';
                }

                function isMobile() {
                    return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                }

                // Map Highlighting Logic (retained)
                async function highlightCountry(countryCode, state) {
                    if (!map || !countryCode) return;

                    const coords = COUNTRY_COORDS[countryCode.toUpperCase()];
                    if (!coords) {
                        console.log("No coordinates for", countryCode);
                        return;
                    }

                    // Remove previous marker
                    if (activeMarker) {
                        map.removeLayer(activeMarker);
                    }

                    // Move map
                    map.flyTo([coords.lat, coords.lon], 6, {
                        animate: true,
                        duration: 2.5,     // seconds (increase for slower)
                        easeLinearity: 0.25
                    });
                    // Add marker
                    activeMarker = L.marker([coords.lat, coords.lon])
                        .addTo(map)
                        .bindPopup(countryCode)
                        .openPopup();
                }
                
                document.querySelector("form").addEventListener("submit", () => {
                const btn = document.getElementById("searchBtn");
                const text = document.getElementById("btnText");

                btn.disabled = true;
                text.textContent = "wait ...";
                });

            </script>
            <script src="/scripts/audioWeb.js"></script>
        <%- include('../partials/footer'); %>
</body>

