<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
</head>

<header>
    <%- include('../partials/header'); %>
</header>

<link rel=stylesheet type="text/css" href="views/css/style.css">
<style>
html, body {
  margin: 0;
  height: 100%;             /* need for iframe height 100% to work */
}
iframe {
  box-sizing: border-box;   /* make the border size be included in the height */
  display: block;           /* make them block to fix white space margin */
  width: 90%;
}
iframe:nth-child(1) {
  height: 800px;
}
</style>


<body class="my-body">
    <form action='../entryLinks', method='POST', content-type="text/javascript">
    <button type="submit" name='Back' value="Back" >Back</button> 
        
    <!-- 1. The <iframe> (and video player) will replace this <div> tag. -->
    <div id="player"></div>

    <iframe id="ytplayer" type="text/html" width="320" height="180"
    src="https://www.youtube.com/embed/F3rFzkCqpz4?autoplay=1&origin=F3rFzkCqpz4"
    frameborder="0"></iframe>

    <script src="https://www.youtube.com/iframe_api"></script>
    <script>
      // 3. This function creates an <iframe> (and YouTube player)
      //    after the API code downloads.
      var player;
      function onYouTubeIframeAPIReady() {
        player = new YT.Player('player', {
          // height: '360',
          // width: '640',
          videoId: 'M7lc1UVf-VE',
          events: {
            'onReady': onPlayerReady,
            'onStateChange': onPlayerStateChange
          }
        });
      }

      // 4. The API will call this function when the video player is ready.
      function onPlayerReady(event) {
        console.log("ready")
        event.target.playVideo();
      }

      // 5. The API calls this function when the player's state changes.
      //    The function indicates that when playing a video (state=1),
      //    the player should play for six seconds and then stop.
      var done = false;
      function onPlayerStateChange(event) {
        if (event.data == YT.PlayerState.PLAYING && !done) {
          setTimeout(stopVideo, 6000);
          done = true;
        }
      }
      function stopVideo() {
        player.stopVideo();
      }
    </script>       <br><br>
    </form>
</body>

<footer>
    <br>
    <%- include('../partials/footer'); %>
</footer>

</body>
</html>
