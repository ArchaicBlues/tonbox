    <!-- Filter Functions for Audio and Video -->
    <script>
        function suppressSearchSubmit(inputId) {
            const searchInput = document.getElementById(inputId);
            if (!searchInput) return;

            searchInput.addEventListener('keydown', function(event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                }
            });
        }

        function filterAudioTracks() {
            const searchInput = document.getElementById('searchtext');
            const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
            const buttContainer = document.getElementById('butt');
            if (!buttContainer) return;

            const buttons = buttContainer.querySelectorAll('button');
            buttons.forEach(button => {
                const buttonText = (button.innerText || button.textContent || '').toLowerCase();
                if (searchTerm === '' || buttonText.includes(searchTerm)) {
                    button.style.display = 'inline-block';
                } else {
                    button.style.display = 'none';
                }
            });
        }

        function resetAudioSearch() {
            const searchInput = document.getElementById('searchtext');
            if (searchInput) {
                searchInput.value = '';
                filterAudioTracks();
                searchInput.focus();
            }
        }

        function filterVideoTracks() {
            const searchInput = document.getElementById('searchtextVideo');
            const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
            const videoButtContainer = document.getElementById('videobutt');
            if (!videoButtContainer) return;

            const buttons = videoButtContainer.querySelectorAll('button');
            buttons.forEach(button => {
                const buttonText = (button.innerText || button.textContent || '').toLowerCase();
                if (searchTerm === '' || buttonText.includes(searchTerm)) {
                    button.style.display = 'inline-block';
                } else {
                    button.style.display = 'none';
                }
            });
        }

        function resetVideoSearch() {
            const searchInput = document.getElementById('searchtextVideo');
            if (searchInput) {
                searchInput.value = '';
                filterVideoTracks();
                searchInput.focus();
            }
        }

        suppressSearchSubmit('searchtext');
        suppressSearchSubmit('searchtextVideo');
    </script>

    <%if (loc.match("Audio") || loc.match("Radio/")) {%>
<script>
document.addEventListener("DOMContentLoaded", function () {

    let buttonCon = document.getElementById("button-container");
    let buttonBack = document.getElementById("back");
    let delItems = [];
    let lastClickId = "";
    let lastClickTs = 0;
    const dblClickWindowMs = 450;

    buttonCon.addEventListener("click", function(event) {       
        let button = event.target.closest("button");
        if (!button || !button.id) return;
        let name = (button.innerText || button.textContent || "").trim();
        if (!name) return;

        if (delItems.includes(name)) {
            // single click on selected item -> unselect
            button.style = "";
            delItems = delItems.filter(item => item !== name);
            lastClickId = "";
            lastClickTs = 0;
            updateBackButton();
            return;
        }

        const now = Date.now();
        const isDoubleClick = (lastClickId === button.id) && ((now - lastClickTs) <= dblClickWindowMs);
        if (isDoubleClick) {
            button.style = "text-decoration: line-through; color:red;";
            delItems.push(name);
            lastClickId = "";
            lastClickTs = 0;
            updateBackButton();
            return;
        }

        // first click: remember only, no visual change
        lastClickId = button.id;
        lastClickTs = now;
    });

    function updateBackButton() {
        if (delItems.length > 0) {
            buttonBack.style = "color:red;";
            buttonBack.innerHTML = "Back / Delete";
            if (dirType.match("Video"))
                buttonBack.value = "DeleteVideo " + delItems;
            else if (dirType.match("Audio"))
                buttonBack.value = "DeleteAudio " + delItems;
            else if (dirType.match("Radio"))
                buttonBack.value = "DeleteRadio " + delItems;
        } else {
            buttonBack.style = "";
            buttonBack.innerHTML = "Back";
            buttonBack.value = "dirMain";
        }

        console.log("Selected:", delItems);
    }
})
</script>
