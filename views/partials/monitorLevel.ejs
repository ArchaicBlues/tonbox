<!-- used in audioCapture.ejs & audioCaptureTape.ejs -->
<div id="levelModal" class="modal">
  <div class="modal-content">
    <span class="close-btn" onclick="closeLevelModal()">&times;</span>
    <h2>Audio Input Level</h2>
    <b>adjust between 0.60...0.95</b>
    <br>
    <h2 style="display: flex; justify-content: center;" id="levelValue"></h2>
  </div>
</div>

<div id="recordModal" class="modal">
    <div class="modal-content">
        <h2>Recording started ...</h2>
        <h3 style="display: flex; justify-content: center;" id="recordValue"></h2>
        <br><br>
        <button style="display: flex; justify-content: center;" onclick="stopRecording()">&times;Stop recording</button>
    </div>
</div>

<div id="analyzerModal" class="modal">
    <div class="modal-content">
        <h2>Analyzer started ...</h2>
        <h3 style="display: flex; justify-content: center;" id="analyzerValue"></h2>
        <br><br>
        <button style="display: flex; justify-content: center;" onclick="stopAnalyzer()">&times;Stop analyzer</button>
    </div>
</div>
