<script>
  // Restore the desktop sidebar-collapsed state before first paint, so the
  // sidebar never briefly flashes open and then animates shut on page load.
  (function () {
    try {
      if (window.innerWidth > 768 && localStorage.getItem("sidebarCollapsed") === "1") {
        document.body.classList.add("sidebar-collapsed");
      }
    } catch (e) {}
  })();
</script>
<style>
  /* Header & Sidebar Specific Styles - supplementing modern.css */

  /* Top Bar */
  .top-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 var(--spacing-md);
    z-index: 1000;
    background: rgba(15, 12, 41, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--glass-border);
  }

  .brand {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-color);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand img {
    height: 32px;
    border-radius: 50%;
  }

  /* Sidebar Navigation */
  .sidebar {
    position: fixed;
    left: 0;
    top: 64px;
    bottom: 0;
    width: 207px;
    background: rgba(15, 12, 41, 0.6);
    backdrop-filter: blur(15px);
    border-right: 1px solid var(--glass-border);
    padding: 40px var(--spacing-md) var(--spacing-md);
    transform: translateX(0);
    transition: transform 0.3s ease;
    z-index: 900;
    overflow-y: auto;
  }

  @media (max-width: 780px) {
    .sidebar {
      transform: translateX(-100%);
    }

    .sidebar.active {
      transform: translateX(0);
    }
  }

  .nav-group {
    margin-bottom: var(--spacing-lg);
  }

  .nav-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    letter-spacing: 1px;
    margin-bottom: var(--spacing-xs);
    padding-left: 0.8rem;
  }

  .nav-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.2rem 0.8rem 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.8rem;
    text-align: left;
    transition: color 0.2s ease;
  }

  .nav-toggle:hover {
    color: var(--accent-color);
  }

  .nav-toggle i {
    transition: transform 0.2s ease;
  }

  .nav-toggle[aria-expanded="true"] i {
    transform: rotate(180deg);
  }

  .nav-submenu {
    display: block;
    transition: max-height 0.25s ease, opacity 0.25s ease;
    overflow: hidden;
  }

  .nav-submenu.collapsed {
    display: none;
  }

  .nav-item {
    display: block;
    padding: 0.8rem;
    border-radius: 10px;
    color: var(--text-main);
    font-weight: 500;
    transition: all 0.2s;
  }

  .nav-item:hover,
  .nav-item.active {
    background: rgba(0, 210, 255, 0.1);
    color: var(--accent-color);
    transform: translateX(5px);
  }

  .nav-item i {
    margin-right: 10px;
    width: 20px;
    text-align: center;
  }
  .mobile-toggle {
    display: none;
    width: 42px;
    height: 42px;
    padding: 0;
    border-radius: 12px;
    font-size: 1.4rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
  }

  @media (max-width: 768px) {
    .mobile-toggle {
      display: flex;
    }

    .top-bar {
      padding-left: 12px;
      padding-right: 12px;
    }
  }

  /* Main Content Adjustment */
  body {
    padding-top: 64px;
    padding-left: 200px;
    /* Offset for sidebar */
    padding-bottom: 10px;
    transition: padding-left 0.3s ease;
  }

  @media (max-width: 768px) {
    body {
      padding-left: 0;
    }
  }

  /* Desktop: sidebar collapsible via the same toggle button */
  @media (min-width: 769px) {
    body.sidebar-collapsed {
      padding-left: 0;
    }

    body.sidebar-collapsed .sidebar {
      transform: translateX(-100%);
    }
  }

  .shutdown-item {
    border-top: 2px solid red; /* red line above */
    padding-top: 8px;          /* optional: space between line and text */
    margin-top: 8px;           /* optional: space from previous items */
    color: red !important;
  }
</style>


