<div id="marquee-container"></div>

  <!-- Modal -->
  <div id="recModal" class="rec-modal">
    <div class="rec-modal-content">
      <h2>Scheduled Recordings</h2>
      <div id="recList"></div>

      <div class="modal-footer">
        <button onclick="closeRecModal()" class="btn-modern">
          Close
        </button>
      </div>
    </div>
  </div>

    <script>
    // const ws = new WebSocket('ws://192.168.2.140:8080');

    // // Optional: Nur melden, wenn Verbindung offen ist
    // ws.onopen = () => {
    //   console.log('WebSocket Verbindung hergestellt.');
    // };

    // ws.onmessage = (event) => {
    //   // Sicherstellen, dass Daten da sind
    //   if (event.data) {
    //     // Verhindert Alerts bei leeren Handshakes oder Ping-Pongs
    //     if (typeof event.data === 'string' && event.data.trim() !== "") {
    //      // window.alert(event.data);
    //     }
    //     console.log('Nachricht:', event.data);
    //   }
    // };

    // ws.onerror = (error) => {
    //   console.error('WebSocket Fehler:', error);
    // };      

    const scheduledRadioRecJobs = <%- JSON.stringify(recording || []) %>;

      async function openRecModal() {
        console.log("openRecModal")

        const modal = document.getElementById("recModal");
        modal.style.display = "flex";
        const list = document.getElementById("recList");
        list.innerHTML = "";
        if (!scheduledRadioRecJobs || scheduledRadioRecJobs.length === 0) {
            list.innerHTML = "<p>No scheduled recordings</p>";
        } else {
          scheduledRadioRecJobs.forEach(job => {
              const div = document.createElement("div");
                div.className = "rec-job";
              const start = new Date(Number(job.startTime)).toLocaleString();
              const stop  = new Date(Number(job.stopTime)).toLocaleString();
              div.innerHTML = `
                  <strong>${job.radioUrl}</strong><br>
                  <small>Start:</small> ${start}<br>
                  <small>Stop:</small> ${stop}<br>
                  <button onclick="stopJob('${job.jobId}')">
                      Stop Recording
                  </button>
              `;
              list.appendChild(div);
          });
        }
        document.getElementById("recModal").style.display = "flex";
      }

      function closeRecModal() {
          document.getElementById("recModal").style.display = "none";
      }

      async function stopJob(jobId) {
        fetch('/radioFavorites', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ stoprec: jobId })
        })
        .then(res => res.json())
        .then(data => {
          location.reload(true) //refresh page thru server
          if (data.success) {
              openRecModal(); // reload list
          }
        })
        .catch(err => console.error("Reverb error:", err));

          // const res = await fetch(`/stoprec?jobId=${jobId}`);
          // const data = await res.json();

          // if (data.success) {
          //     openRecModal(); // reload list
          // }
      }        

      function toggleSidebar() {
        if (window.innerWidth <= 768) {
          document.querySelector(".sidebar").classList.toggle("active");
          return;
        }
        const collapsed = document.body.classList.toggle("sidebar-collapsed");
        try {
          localStorage.setItem("sidebarCollapsed", collapsed ? "1" : "0");
        } catch (e) {}
      }

      document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById("recModal");
        if (modal) modal.style.display = "none";

        const sidebar = document.querySelector(".sidebar");
        const syncSidebarState = () => {
          if (window.innerWidth <= 768) {
            sidebar.classList.remove("active");
          } else {
            sidebar.classList.add("active");
          }
        };

        syncSidebarState();
        window.addEventListener("resize", syncSidebarState);

        document.querySelectorAll(".nav-toggle").forEach((button) => {
          button.addEventListener("click", () => {
            const submenu = button.nextElementSibling;
            if (!submenu || !submenu.classList.contains("nav-submenu")) return;

            const isExpanded = button.getAttribute("aria-expanded") === "true";
            button.setAttribute("aria-expanded", String(!isExpanded));
            submenu.classList.toggle("collapsed", isExpanded);
          });
        });
      });

      document.addEventListener("click", function (event) {
        const sidebar = document.querySelector(".sidebar");
        const toggleBtn = document.querySelector(".mobile-toggle");

        // Nur auf Mobile relevant
        if (window.innerWidth > 768) return;

        const isClickInsideSidebar = sidebar.contains(event.target);
        const isClickOnToggle = toggleBtn.contains(event.target);

        if (!isClickInsideSidebar && !isClickOnToggle) {
          sidebar.classList.remove("active");
        }
      });

      document.addEventListener("DOMContentLoaded", () => {
          const fullViewBtn = document.getElementById("fullViewBtn");

          function isFullView() {
              return !!(document.fullscreenElement || document.webkitFullscreenElement);
          }

          function updateFullViewBtn() {
              if (!fullViewBtn) return;
              fullViewBtn.innerHTML = isFullView()
                  ? '<i class="bi bi-fullscreen-exit"></i>'
                  : '<i class="bi bi-arrows-fullscreen"></i>';
          }

          if (fullViewBtn) {
              fullViewBtn.addEventListener("click", (event) => {
                  event.preventDefault();
                  const el = document.documentElement;
                  if (!isFullView()) {
                      const req = el.requestFullscreen || el.webkitRequestFullscreen;
                      if (req) req.call(el);
                  } else {
                      const exit = document.exitFullscreen || document.webkitExitFullscreen;
                      if (exit) exit.call(document);
                  }
              });

              document.addEventListener("fullscreenchange", updateFullViewBtn);
              document.addEventListener("webkitfullscreenchange", updateFullViewBtn);
          }

          //this app reloads a full page on every navigation, which normally
          //exits FullView; re-requesting it in the same click as the actual
          //navigation trigger is the only way browsers allow FullView to
          //carry over, since it needs a live user gesture
          document.addEventListener("click", function (event) {
              if (!isFullView()) return;
              var target = event.target.closest('a[href], button[type="submit"], input[type="submit"]');
              if (!target) return;
              if (target.tagName === "A") {
                  var href = target.getAttribute("href");
                  if (!href || href === "#" || href.indexOf("javascript:") === 0) return;
              }
              try {
                  var el = document.documentElement;
                  var req = el.requestFullscreen || el.webkitRequestFullscreen;
                  if (req) req.call(el);
              } catch (e) {}
          }, true);
      });

      document.addEventListener("DOMContentLoaded", () => {
          const btn = document.getElementById("shutdownBtn");

          btn.addEventListener("click", (event) => {
              event.preventDefault();

              // UI anzeigen
              document.body.innerHTML = `
                  <div style="
                      background:#000;
                      color:#ff4d4d;
                      display:flex;
                      justify-content:center;
                      align-items:center;
                      height:100vh;
                      font-size:2rem;
                      font-family:sans-serif;
                      flex-direction:column;
                      text-align:center;
                  ">
                      <div>Shutting down...</div>
                      <div style="margin-top:20px; font-size:1.5rem;">
                          Turn power off after 5 seconds
                      </div>
                  </div>
              `;

              // Jetzt bewusst verzögert den Request senden
              setTimeout(() => {
                  window.location.href = "/entry?src=shutdown";
              }, 1500); // leicht erhöht, damit UI sichtbar ist
          });
      });
</script>

